# ---- Database (PostgreSQL 15+ with the pgvector extension installed) ----
DATABASE_URL=postgresql://user:password@localhost:5432/studyos

# ---- Redis (background job queue) ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-32-bytes-of-random

# ---- LLM provider ----
# Supported: anthropic
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# ---- Embeddings provider ----
# Supported: voyage | openai. Must match EMBEDDING_DIM in the migration.
EMBEDDING_PROVIDER=voyage
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

# ---- Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO) ----
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=studyos-textbooks
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- OCR (optional; scanned PDFs fail cleanly without it) ----
# Supported: none | tesseract | google-vision
OCR_PROVIDER=none
OCR_API_KEY=
# Tesseract language packs: 'ben' for Bangla, 'eng' for English
OCR_LANGUAGES=ben+eng

# ---- Limits ----
MAX_UPLOAD_BYTES=104857600
